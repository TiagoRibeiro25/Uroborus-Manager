{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Uroborus Manager",
	"version": "0.1.0",
	"identifier": "com.tiago.uroborus-manager",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Uroborus Manager",
				"width": 1200,
				"height": 780,
				"minWidth": 860,
				"minHeight": 640,
				"decorations": false
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["$APPDATA/**", "$DATA/**", "$HOME/**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "msi",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
